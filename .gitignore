# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# local scratch / design drafts — not tracked
tmp/

# Playwright e2e run artifacts (test/e2e/ itself IS tracked)
/test-results/
/playwright-report/

# Bundled real source for e2e tests — rebuilt fresh by globalSetup before
# every run, same treatment as main.js
/test/e2e/common/real-bundle.generated.js

# Playwright MCP tool session artifacts (screenshots/console logs)
/.playwright-mcp/

# CodeGraph index (local, machine-specific)
/.codegraph/

# local Claude config (contains personal vault paths)
CLAUDE.md
# Windows Alternate Data Streams
*:*
